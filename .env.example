# Finaler Methodenbot. Diese Datei enthaelt keine Zugangsdaten.
# Produktion setzt METHODENBOT_ENV_FILE=/etc/methodenbot/runtime.env und
# METHODENBOT_STATE_DIR=/var/lib/methodenbot ueber systemd.

UK_NUMMER=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EWS_ENDPOINT=

MATRIX_SERVER=
MATRIX_USER=
MATRIX_PASSWORD=
MATRIX_ROOM_ID=
# Bereits vorhandene, unverschluesselte Zweier-PN: nur Bot und Kontrollperson.
MATRIX_CONSOLE_ROOM_ID=
MATRIX_CONTROL_USER=
MATRIX_DEVICE_ID=METHODENBOT_FINAL_2026_08
MATRIX_ALLOW_UNENCRYPTED_CONTROL_DM=false

GOOGLE_FORM_LINK=
DEV_ENABLE_TOKEN_CACHE=false

# Administrative KI-Freigabe. Der persistente Schalter startet separat AUS.
METHODENBOT_AI_ENABLED=true
METHODENBOT_AI_DEFAULT_ENABLED=false
GWDG_DATA_TRANSFER_APPROVED=true
GWDG_MODEL=qwen3-30b-a3b-instruct-2507
# In Produktion bevorzugt systemd LoadCredential; dann nicht setzen.
GWDG_API_KEY_FILE=
